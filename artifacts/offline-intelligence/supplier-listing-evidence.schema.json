{
  "$defs": {
    "ShippingEvidence": {
      "additionalProperties": false,
      "properties": {
        "price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "destination_country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination Country"
        },
        "terms": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms"
        }
      },
      "title": "ShippingEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "product_entity_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Entity Id"
    },
    "identity_hypothesis_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identity Hypothesis Id"
    },
    "provider": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "listing_title": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Listing Title",
      "type": "string"
    },
    "listing_url": {
      "maxLength": 4000,
      "title": "Listing Url",
      "type": "string"
    },
    "price": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price"
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "min_order": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Order"
    },
    "shipping": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShippingEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "country": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "rating": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rating"
    },
    "rating_scale": {
      "default": 5,
      "exclusiveMinimum": 0.0,
      "title": "Rating Scale",
      "type": "number"
    },
    "orders": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Orders"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "match_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Match Confidence"
    },
    "review_status": {
      "default": "unreviewed",
      "enum": [
        "unreviewed",
        "reviewed",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "listing_title",
    "listing_url",
    "observed_at"
  ],
  "title": "SupplierListingEvidence",
  "type": "object"
}