{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ui-v2 && npm ci && npm run build",
  "outputDirectory": "ui-v2/dist",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
