{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Product Hunter Companion",
  "version": "0.1.4",
  "description": "Read-only TikTok companion for the local Product Hunter dashboard.",
  "permissions": [
    "storage", "tabs", "alarms"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "search_results.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Product Hunter Companion"
  }
}
